# =============================================================
# CAKEBOX - application.properties
# Uses environment variables for all secrets.
# Safe to push to GitHub - no real passwords here!
# =============================================================

server.port=${PORT:8080}

# ── DATABASE ──────────────────────────────────────────────────
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/cakeboxdb?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:@Boomab12345}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ── JPA ───────────────────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ── JWT ───────────────────────────────────────────────────────
jwt.secret=${JWT_SECRET:cakebox-super-secret-key-change-this-in-production-2024}
jwt.expiration=${JWT_EXPIRATION:86400000}

# ── CLOUDINARY ────────────────────────────────────────────────
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:ddxtz0gj3}
cloudinary.api-key=${CLOUDINARY_API_KEY:189736111298897}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:4vFt6lrExpKdppne28Q47mT_T_U}

# ── RAZORPAY ──────────────────────────────────────────────────
razorpay.key-id=${RAZORPAY_KEY_ID:rzp_test_SXqYeQycHTAiSI}
razorpay.key-secret=${RAZORPAY_KEY_SECRET:cR04Eis9DzzsarGXvOqNljI8}

# ── FILE UPLOAD ───────────────────────────────────────────────
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ── LOGGING ───────────────────────────────────────────────────
logging.level.com.cakebox=INFO
spring.application.name=cakebox-backend